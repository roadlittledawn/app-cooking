# MongoDB
# Use a local or dev database for development: writes from the app are real.
MONGODB_URI=mongodb://localhost:27017/app-cooking

# clang-auth (sign-in). See docs/clang-auth-migration.md.
# Production: AUTH_BASE_URL=https://auth.clintonlangosch.com
AUTH_BASE_URL=http://auth.localtest.me:4000
AUTH_APP_SLUG=cooking

# Vercel Blob (image uploads)
# Get from: Vercel dashboard → Storage → your Blob store → .env.local
BLOB_READ_WRITE_TOKEN=<your-blob-token>
