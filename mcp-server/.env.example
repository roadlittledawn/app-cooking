# Copy to mcp-server/.env (gitignored), then rebuild and reconnect (/mcp).

# clang-auth API key for the `cooking` app (ca_key_…). Create one at
# https://auth.clintonlangosch.com/keys?app=cooking
CLANG_AUTH_API_KEY=

# Defaults are production. For local dev:
#   COOKING_BASE_URL=http://cooking.localtest.me:3004
#   AUTH_BASE_URL=http://auth.localtest.me:4000
COOKING_BASE_URL=https://cooking.clintonlangosch.com
AUTH_BASE_URL=https://auth.clintonlangosch.com
